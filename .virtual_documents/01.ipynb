# LOAD DATASET
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
data = pd.read_csv("Car details v3.csv")


# SEE TOP 5 ROWS OF DATASER
data.head()


# TAKE INFO OF DATA
data.info()


# COUNT THE NULL VALUES IN EACH COLUMNS
data.isnull().sum()


data.head()


# DROP UNNECESSORY COLUMNS 
data = data.drop(["name","torque"], axis = 1)


data.head()


# CONVERT MIXED DATA INTO ONE FORM
data["mileage"] = data["mileage"].str.replace(" kmpl", "")
data["engine"] = data["engine"].str.replace(" CC", "")
data["max_power"] = data["max_power"].str.replace(" bhp", "")



data.head()


data.info()


# CONVERT STR TO INT/FLOAT DATATYPE
data["mileage"] = pd.to_numeric(data["mileage"], errors = "coerce")
data["engine"] = pd.to_numeric(data["engine"], errors = "coerce")
data["max_power"] = pd.to_numeric(data["max_power"], errors = "coerce")


data.info()


# FILL NULL VALUES OF DIFFERENT COLUMNS WITH MEDIAN OF COLUMN DATA
data["mileage"] = data["mileage"].fillna(data["mileage"].median)
data["engine"] = data["engine"].fillna(data["engine"].median)
data["max_power"] = data["max_power"].fillna(data["max_power"].median)
data["seats"] = data["seats"].fillna(data["seats"].median)


data.info()


data.head()


# ISME HAME DIFFERENT categorical column KI DIFFERENT COLUMNS BANA DIYE HAI JISME DATA BINARY FORM ME HAI JO PHALE TEXT(STRING) ME THA 
data = pd.get_dummies(data, columns=['fuel', 'seller_type', 'transmission', 'owner'], drop_first=True)


data


data["age"] = 2026 - data["year"]


data.head()





plt.hist(data["selling_price"], bins = 50, range = (0, 1000000))
plt.title("SELLING PRICE GRAPH")
plt.xlabel("PRICE")
plt.ylabel("COUNT")
plt.show()


plt.scatter(data["age"], data["selling_price"], alpha = 0.5)
plt.title("CAR AGE vs SELLING PRICE")
plt.xlabel("Cars Age")
plt.ylabel("Car Price")
plt.show()


plt.scatter(data["km_driven"], data["selling_price"], alpha = 0.5)
plt.title("CAR DRIVEN vs SELLING PRICE")
plt.xlabel("Cars Driven")
plt.ylabel("Car Price")
plt.show()


data.info()


plt.scatter(data["max_power"], data["selling_price"], alpha = 0.5)
plt.title("CAR POWER vs SELLING PRICE")
plt.xlabel("Cars Power")
plt.ylabel("Car Price")
plt.show()


plt.figure(figsize=(8,5))
sns.boxplot(x='fuel_Diesel', y='selling_price', data=data)
plt.title("Fuel Type vs Price")
plt.show()


plt.figure(figsize=(8,5))
sns.boxplot(x='transmission_Manual', y='selling_price', data=data)
plt.title("Transmission vs Price")
plt.show()


plt.figure(figsize=(10,5))
plt.hist(data['selling_price'], bins=40)
plt.title("Car Selling Price Distribution")
plt.xlabel("Price")
plt.ylabel("Count")
plt.show()





